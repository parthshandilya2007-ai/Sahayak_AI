{
  "framework": "nextjs",
  "installCommand": "echo 'Using npm'",
  "buildCommand": "cd frontend_template && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "frontend_template/.next",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
